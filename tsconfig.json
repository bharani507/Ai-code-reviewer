{
  "compilerOptions": {
    "incremental": false,
    "sourceMap": false,
    "allowJs": true,
    "checkJs": false,

    "moduleResolution": "node16",
    "module": "Node16",

    "resolveJsonModule": true,
    "isolatedModules": true,
    "target": "ESNext",

    "outDir": "./dist",
    "rootDir": "./src",

    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "__tests__"]
}